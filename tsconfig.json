{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["chrome", "@types/wicg-file-system-access"]
  },
  "include": ["src/**/*", "manifest.json"]
}