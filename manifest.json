{
    "name": "ITSM Painter",
    "description": "Customize colors for teams, set reminders for tasks, and change the design.",
    "version": "2.0",
    "manifest_version": 3,
    "icons": {
        "128": "src/icons/logo/128.png"
    },
    "action": {
        "default_popup": "src/popup/popup.html"
    },
    "permissions": ["activeTab", "storage"],
    "content_scripts": [
        {
            "matches": [
                "http://*.itsm.mos.ru/*",
                "https://*.itsm.mos.ru/*"
            ],
            "js": ["./src/app-scripts/itsm-painter.scripts.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["src/icons/Show.svg", "src/icons/Hidden.svg", "src/icons/Random.svg"],
            "matches": ["<all_urls>"],
            "use_dynamic_url": true
        }
    ]
}