{
    "name": "ITSM Painter",
    "description": "Настраивайте цвета для команд, задавайте напоминания для задач, меняйте оформление.",
    "version": "1.1",
    "manifest_version": 3,
    "icons": {
        "128": "src/icons/logo/128.png"
    },
    "action": {
        "default_popup": "./src/popup/popup.html"
    },
    "permissions": ["tabs", "activeTab", "storage"],
    "background":{},
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["./src/itsm-painter.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["src/icons/Show.svg", "src/icons/Hidden.svg", "src/icons/Random.svg"],
            "matches": ["<all_urls>"],
            "use_dynamic_url": true
        }
    ]
}